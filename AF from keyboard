// ==/UserScript==
// 1.1 - limited queries
// 1.2 - introduce smartSending

// Config - when send A (otherwise send B)
const config = {
  isWallQuestionMarkOrZero: true
};


onInit();

function onInit()
{
    $("a.farm_icon_c, a.farm_icon_b, a.farm_icon_a").click(function() {
        $(this).closest("tr").remove()
})

}

function smartSending()
{
    console.log("smartSending");
    let wallLevel = $("#plunder_list tr.row_a, #plunder_list tr.row_b")[0].children[6].innerText;

    if (
        (config.isWallQuestionMarkOrZero && (wallLevel != "?" && wallLevel != 0))
    )
        sendAttack("b");
    else
        sendAttack("a");

}


function sendAttack(attackLetter)
{
    $(".farm_icon_" + attackLetter)[1].click();
    console.log("send " + attackLetter);
}

document.addEventListener('keydown', function(event) {
   if(event.key == 'q')
        sendAttack("a");
    else if(event.key == 'w')
        sendAttack("b");
    else if(event.key == '`')
        smartSending();
});
