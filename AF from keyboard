// ==/UserScript==
// 1.1 - limited queries
// 1.2 - introduce smartSending
// 1.3 - add maxLootFlag to smartSending


// Config - when send A (otherwise send B)

const config1 = {
  isWallQuestionMarkOrZero: true,
  isMaxLoot: true
};

const config2 = {
  isWallQuestionMarkOrZero: true,
  isMaxLoot: false
};

////

onInit();

function onInit()
{
    $("a.farm_icon_c, a.farm_icon_b, a.farm_icon_a").click(function() {
        $(this).closest("tr").remove()
})

}

function smartSending(config)
{
    console.log("smartSending");
    let wallLevel = $("#plunder_list tr.row_a, #plunder_list tr.row_b")[0].children[6].innerText;
    let lootImg = $("#plunder_list tr.row_a, #plunder_list tr.row_b")[0].children[2].children[0].src;
    let maxLootFlag = lootImg.indexOf("max_loot/1") > 0;

    if (
        (config.isWallQuestionMarkOrZero && (wallLevel != "?" && wallLevel != 0)
        || (config.isMaxLoot && maxLootFlag))
    )
        sendAttack("b");
    else
        sendAttack("a");

}


function sendAttack(attackLetter)
{
    $(".farm_icon_" + attackLetter)[1].click();
    console.log("send " + attackLetter);
}

document.addEventListener('keydown', function(event) {
   if(event.key == 'q')
        sendAttack("a");
    else if(event.key == 'w')
        sendAttack("b");
    else if(event.key == '`')
        smartSending(config1);
    else if(event.key == 'Escape')
        smartSending(config2);
});
