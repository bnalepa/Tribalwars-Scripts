function sendA()
{
$(".farm_icon_a")[1].click();
}

function sendB()
{
$(".farm_icon_b")[1].click();
}

document.addEventListener('keydown', function(event) {
   if(event.key == 'q')
        sendA();
    else if(event.key == 'w')
        sendB();
});
