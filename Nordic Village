(function() {
    'use strict';

    const building = document.querySelector('.visual-building-church_f1');
    if (building) {
        Object.assign(building.style, {
            width: '128px',
            height: '120px',
            left: '415px',
            top: '125px',
            backgroundImage: 'url(https://i.ibb.co/wr4wQmpw/obraz-2025-05-13-134312403.png)',
            backgroundPosition: 'center',
            backgroundSize: 'contain',
            backgroundRepeat: 'no-repeat',
            position: 'absolute'
        });

    }
})();
